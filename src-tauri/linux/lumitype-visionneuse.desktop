[Desktop Entry]
Type=Application
Name=Lumitype Visionneuse
GenericName=Visionneuse d'images
GenericName[en]=Image Viewer
Comment=Regarder ses images et celles d'un dossier (zoom, pellicule, comparaison, diaporama)
