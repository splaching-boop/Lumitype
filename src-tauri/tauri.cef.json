{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "bash packaging/lib/cef-bundle.sh"
  },
  "bundle": {
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/Lumitype": "../target/release/cef-bundle"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/Lumitype": "../target/release/cef-bundle"
        },
        "compression": {
          "type": "zstd",
          "level": 3
        }
      },
      "appimage": {
        "files": {
          "/usr/lib/Lumitype": "../target/release/cef-bundle"
        }
      }
    }
  }
}
